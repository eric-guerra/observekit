{
  "uid": "slo-inventory",
  "title": "inventory — RED + SLOs",
  "schemaVersion": 36,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "generated",
    "slo"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (route) (rate(http_server_requests_total{service=\"inventory\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error ratio (5xx)",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_total{service=\"inventory\",status_class=\"5xx\"}[5m])) / sum(rate(http_server_requests_total{service=\"inventory\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 3,
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_duration_seconds_bucket{service=\"inventory\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_seconds_bucket{service=\"inventory\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_duration_seconds_bucket{service=\"inventory\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "title": "inventory_latency: error budget remaining (30d)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 5
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "1 - (avg_over_time(slo:inventory_latency:error_ratio_1h[30d]) / 0.005)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        }
      }
    }
  ]
}
